# Виртуальное окружение и байт-код
.venv/
__pycache__/
*.pyc

# Движки и веса нейросетей: 340+ МБ, в git и GitHub им не место.
# Они кладутся в bin/ отдельно, модели качаются сами при первом запуске.
bin/

# Готовые файлы пользователя
output/

# Промежуточные кадры, загруженные исходники и логи.
# Тесты в tmp/ при этом остаются в репозитории, вместе с package.json —
# без него jsdom-тесты запустить нечем.
tmp/*
!tmp/*.py
!tmp/*.js
!tmp/package.json
!tmp/package-lock.json
tmp/node_modules/
tmp/engines/
tmp/fx_*
tmp/e2e_*
tmp/*.log

# Личные настройки и пользовательские пресеты
presets/*.json

# Служебное
.vscode/
.idea/
Thumbs.db
desktop.ini
